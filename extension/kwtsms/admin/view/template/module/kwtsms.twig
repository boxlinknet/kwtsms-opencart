<script>
$(document).ready(function() {
  // ---------------------------------------------------------------
  // Alert helper
  // ---------------------------------------------------------------
  function showAlert(type, message) {
    var html = '<div class="alert alert-' + type + ' alert-dismissible fade show">';
    html += message;
    html += '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
    html += '</div>';
    $('#kwtsms-alert').html(html);
    setTimeout(function() {
      $('#kwtsms-alert .alert').alert('close');
    }, 5000);
  }

  // ---------------------------------------------------------------
  // URL declarations (decode &amp; from Twig auto-escaping)
  // ---------------------------------------------------------------
  function decodeUrl(s) { return s.replace(/&amp;/g, '&'); }
  var URL_SAVE             = decodeUrl('{{ save }}');
  var URL_GATEWAY_LOGIN    = decodeUrl('{{ gateway_login_url }}');
  var URL_GATEWAY_LOGOUT   = decodeUrl('{{ gateway_logout_url }}');
  var URL_GATEWAY_RELOAD   = decodeUrl('{{ gateway_reload_url }}');
  var URL_GATEWAY_SAVE     = decodeUrl('{{ gateway_save_url }}');
  var URL_GATEWAY_TEST     = decodeUrl('{{ gateway_test_url }}');
  var URL_SMS_LOG          = decodeUrl('{{ sms_log_url }}');
  var URL_DEBUG_LOG        = decodeUrl('{{ debug_log_url }}');
  var URL_CLEAR_SMS_LOG    = decodeUrl('{{ clear_sms_log_url }}');
  var URL_CLEAR_DEBUG_LOG  = decodeUrl('{{ clear_debug_log_url }}');
  var URL_RESET_TEMPLATE   = decodeUrl('{{ reset_template_url }}');

  // ---------------------------------------------------------------
  // Tab persistence via URL hash
  // ---------------------------------------------------------------
  var hash = window.location.hash;
  if (hash) {
    var tabLink = $('#kwtsms-tabs a[href="' + hash + '"]');
    if (tabLink.length) {
      var tab = new bootstrap.Tab(tabLink[0]);
      tab.show();
    }
  }

  $('#kwtsms-tabs a[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
    window.location.hash = $(e.target).attr('href');

    // Auto-load log data when switching to logs tab
    if ($(e.target).attr('href') === '#tab-logs') {
      loadSmsLog(1);
      loadDebugLog(1);
    }
  });

  // ---------------------------------------------------------------
  // 1. Save button (Settings + Templates tabs)
  // ---------------------------------------------------------------
  $('#button-save').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    var formData = $('#form-settings').serialize();
    formData += '&' + $('#tab-templates input, #tab-templates select, #tab-templates textarea').serialize();

    $.ajax({
      url: URL_SAVE,
      type: 'POST',
      dataType: 'json',
      data: formData,
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 2. Gateway Login
  // ---------------------------------------------------------------
  $('#button-gateway-login').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_GATEWAY_LOGIN,
      type: 'POST',
      dataType: 'json',
      data: {
        username: $('#input-gw-username').val(),
        password: $('#input-gw-password').val()
      },
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
          $('#gateway-login').hide();
          $('#gateway-connected').show();

          // Update connected state display
          if (json.balance !== undefined && json.balance !== null) {
            $('#gw-balance').text(json.balance + ' {{ text_credits }}');
            $('#dash-balance').text(json.balance + ' {{ text_credits }}');
          }
          updateSenderIds(json.senderids);
          updateCoverage(json.coverage);

          // Update dashboard gateway badge
          $('#dash-gateway').removeClass('bg-danger').addClass('bg-success').text('{{ text_connected }}');
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 3. Gateway Logout
  // ---------------------------------------------------------------
  $('#button-gateway-logout').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_GATEWAY_LOGOUT,
      type: 'POST',
      dataType: 'json',
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
          $('#gateway-connected').hide();
          $('#gateway-login').show();
          $('#input-gw-username').val('');
          $('#input-gw-password').val('');

          // Update dashboard
          $('#gw-balance').text('--');
          $('#dash-balance').text('--');
          $('#dash-gateway').removeClass('bg-success').addClass('bg-danger').text('{{ text_disconnected }}');
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 4. Gateway Reload
  // ---------------------------------------------------------------
  $('#button-gateway-reload').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_GATEWAY_RELOAD,
      type: 'POST',
      dataType: 'json',
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);

          if (json.balance !== undefined && json.balance !== null) {
            $('#gw-balance').text(json.balance + ' {{ text_credits }}');
            $('#dash-balance').text(json.balance + ' {{ text_credits }}');
          }
          updateSenderIds(json.senderids);
          updateCoverage(json.coverage);
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 5. Gateway Save Settings
  // ---------------------------------------------------------------
  $('#button-gateway-save').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_GATEWAY_SAVE,
      type: 'POST',
      dataType: 'json',
      data: {
        sender_id: $('#input-sender-id').val(),
        country_code: $('#input-country-code').val(),
        debug: $('#input-gw-debug').is(':checked') ? 1 : 0
      },
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
          // Update dashboard sender ID display
          $('#dash-sender-id').text($('#input-sender-id').val());
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 6. Test Gateway
  // ---------------------------------------------------------------
  $('#button-test-gateway').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_GATEWAY_TEST,
      type: 'POST',
      dataType: 'json',
      data: {
        phone: $('#input-test-phone').val(),
        message: $('#input-test-message').val()
      },
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 7. SMS Log loading
  // ---------------------------------------------------------------
  function loadSmsLog(page) {
    var params = {
      page: page || 1,
      status: $('#sms-filter-status').val(),
      event_type: $('#sms-filter-event').val(),
      date_from: $('#sms-filter-date-from').val(),
      date_to: $('#sms-filter-date-to').val()
    };

    $.ajax({
      url: URL_SMS_LOG,
      type: 'GET',
      dataType: 'json',
      data: params,
      success: function(json) {
        if (json.error) {
          showAlert('danger', json.error);
          return;
        }

        var tbody = $('#sms-log-body');
        tbody.empty();

        if (json.rows && json.rows.length > 0) {
          $.each(json.rows, function(i, row) {
            var statusBadge = '';
            switch (row.status) {
              case 'sent':
                statusBadge = '<span class="badge" style="background-color:#FFA200;color:#fff;">sent</span>';
                break;
              case 'failed':
                statusBadge = '<span class="badge bg-danger">failed</span>';
                break;
              case 'skipped':
                statusBadge = '<span class="badge bg-secondary">skipped</span>';
                break;
              case 'queued':
                statusBadge = '<span class="badge bg-info text-dark">queued</span>';
                break;
              default:
                statusBadge = '<span class="badge bg-secondary">' + (row.status || '') + '</span>';
            }
            var testBadge = row.test_mode == 1 ? '<span class="badge bg-warning text-dark">{{ text_yes }}</span>' : '<span class="badge bg-light text-dark">{{ text_no }}</span>';

            var tr = '<tr>';
            tr += '<td>' + (row.created_at || '') + '</td>';
            tr += '<td>' + (row.recipient || '') + '</td>';
            tr += '<td>' + statusBadge + '</td>';
            tr += '<td>' + (row.event_type || '') + '</td>';
            tr += '<td>' + (row.order_id || '') + '</td>';
            tr += '<td>' + (row.msg_id || '') + '</td>';
            tr += '<td>' + (row.points_charged || '0') + '</td>';
            tr += '<td>' + testBadge + '</td>';
            tr += '</tr>';
            tbody.append(tr);
          });
        } else {
          tbody.html('<tr><td colspan="8" class="text-center">{{ text_no_results }}</td></tr>');
        }

        // Render pagination
        renderPagination('#sms-log-pagination', json.page, json.pages, function(p) { loadSmsLog(p); });
      },
      error: function() {
        showAlert('danger', 'Failed to load SMS log.');
      }
    });
  }

  $('#button-sms-filter').on('click', function() {
    loadSmsLog(1);
  });

  // ---------------------------------------------------------------
  // 8. Debug Log loading
  // ---------------------------------------------------------------
  function loadDebugLog(page) {
    var params = {
      page: page || 1,
      level: $('#debug-filter-level').val(),
      context: $('#debug-filter-context').val(),
      date_from: $('#debug-filter-date-from').val(),
      date_to: $('#debug-filter-date-to').val()
    };

    $.ajax({
      url: URL_DEBUG_LOG,
      type: 'GET',
      dataType: 'json',
      data: params,
      success: function(json) {
        if (json.error) {
          showAlert('danger', json.error);
          return;
        }

        var tbody = $('#debug-log-body');
        tbody.empty();

        if (json.rows && json.rows.length > 0) {
          $.each(json.rows, function(i, row) {
            var levelBadge = '';
            switch (row.level) {
              case 'info':
                levelBadge = '<span class="badge bg-info text-dark">info</span>';
                break;
              case 'warning':
                levelBadge = '<span class="badge bg-warning text-dark">warning</span>';
                break;
              case 'error':
                levelBadge = '<span class="badge bg-danger">error</span>';
                break;
              default:
                levelBadge = '<span class="badge bg-secondary">' + (row.level || '') + '</span>';
            }

            var tr = '<tr>';
            tr += '<td>' + (row.created_at || '') + '</td>';
            tr += '<td>' + levelBadge + '</td>';
            tr += '<td>' + (row.context || '') + '</td>';
            tr += '<td>' + (row.message || '') + '</td>';
            tr += '</tr>';
            tbody.append(tr);
          });
        } else {
          tbody.html('<tr><td colspan="4" class="text-center">{{ text_no_results }}</td></tr>');
        }

        // Render pagination
        renderPagination('#debug-log-pagination', json.page, json.pages, function(p) { loadDebugLog(p); });
      },
      error: function() {
        showAlert('danger', 'Failed to load debug log.');
      }
    });
  }

  $('#button-debug-filter').on('click', function() {
    loadDebugLog(1);
  });

  // ---------------------------------------------------------------
  // 9. Clear SMS Log
  // ---------------------------------------------------------------
  $('#button-clear-sms-log').on('click', function() {
    if (!confirm('{{ text_confirm_clear }}')) {
      return;
    }
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_CLEAR_SMS_LOG,
      type: 'POST',
      dataType: 'json',
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
          loadSmsLog(1);
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 10. Clear Debug Log
  // ---------------------------------------------------------------
  $('#button-clear-debug-log').on('click', function() {
    if (!confirm('{{ text_confirm_clear }}')) {
      return;
    }
    var btn = $(this);
    btn.prop('disabled', true);

    $.ajax({
      url: URL_CLEAR_DEBUG_LOG,
      type: 'POST',
      dataType: 'json',
      success: function(json) {
        btn.prop('disabled', false);
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          showAlert('success', json.success);
          loadDebugLog(1);
        }
      },
      error: function() {
        btn.prop('disabled', false);
        showAlert('danger', 'An error occurred. Please try again.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 11. Template reset buttons
  // ---------------------------------------------------------------
  $(document).on('click', '.btn-reset-template', function() {
    var btn = $(this);
    var templateId = btn.data('id');

    if (!confirm('{{ text_reset_confirm }}')) {
      return;
    }

    $.ajax({
      url: URL_RESET_TEMPLATE,
      type: 'POST',
      dataType: 'json',
      data: { template_id: templateId },
      success: function(json) {
        if (json.error) {
          showAlert('danger', json.error);
        }
        if (json.success) {
          // Find the card containing this button and update textareas
          var card = btn.closest('.card-body');
          card.find('textarea[name$="[body_en]"]').val(json.body_en || '');
          card.find('textarea[name$="[body_ar]"]').val(json.body_ar || '');
          showAlert('success', json.success);
        }
      },
      error: function() {
        showAlert('danger', 'Request failed.');
      }
    });
  });

  // ---------------------------------------------------------------
  // 12. Pagination renderer
  // ---------------------------------------------------------------
  function renderPagination(selector, currentPage, totalPages, callback) {
    var nav = $(selector);
    nav.empty();

    if (totalPages <= 1) {
      return;
    }

    var ul = $('<ul class="pagination pagination-sm mb-0"></ul>');

    // Previous
    var prevLi = $('<li class="page-item' + (currentPage <= 1 ? ' disabled' : '') + '"></li>');
    var prevA = $('<a class="page-link" href="#">&laquo;</a>');
    prevA.on('click', function(e) {
      e.preventDefault();
      if (currentPage > 1) {
        callback(currentPage - 1);
      }
    });
    prevLi.append(prevA);
    ul.append(prevLi);

    // Page numbers (show max 7 pages with ellipsis)
    var startPage = Math.max(1, currentPage - 3);
    var endPage = Math.min(totalPages, currentPage + 3);

    if (startPage > 1) {
      ul.append('<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>');
      if (startPage > 2) {
        ul.append('<li class="page-item disabled"><span class="page-link">...</span></li>');
      }
    }

    for (var p = startPage; p <= endPage; p++) {
      var li = $('<li class="page-item' + (p === currentPage ? ' active' : '') + '"></li>');
      var a = $('<a class="page-link" href="#">' + p + '</a>');
      a.attr('data-page', p);
      a.on('click', function(e) {
        e.preventDefault();
        callback(parseInt($(this).attr('data-page')));
      });
      li.append(a);
      ul.append(li);
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        ul.append('<li class="page-item disabled"><span class="page-link">...</span></li>');
      }
      ul.append('<li class="page-item"><a class="page-link" href="#" data-page="' + totalPages + '">' + totalPages + '</a></li>');
    }

    // Next
    var nextLi = $('<li class="page-item' + (currentPage >= totalPages ? ' disabled' : '') + '"></li>');
    var nextA = $('<a class="page-link" href="#">&raquo;</a>');
    nextA.on('click', function(e) {
      e.preventDefault();
      if (currentPage < totalPages) {
        callback(currentPage + 1);
      }
    });
    nextLi.append(nextA);
    ul.append(nextLi);

    // Bind click for numbered pages added via html string
    ul.find('a[data-page]').off('click').on('click', function(e) {
      e.preventDefault();
      callback(parseInt($(this).attr('data-page')));
    });

    nav.append(ul);
  }

  // ---------------------------------------------------------------
  // 13. Helper: update sender IDs display + dropdown
  // ---------------------------------------------------------------
  function updateSenderIds(senderids) {
    var html = '';
    if (senderids && senderids.length > 0) {
      $.each(senderids, function(i, sid) {
        html += '<span class="badge bg-secondary">' + sid + '</span> ';
      });
      // Update the gateway settings dropdown
      var select = $('#input-sender-id');
      var currentVal = select.val();
      select.empty();
      $.each(senderids, function(i, sid) {
        select.append('<option value="' + sid + '"' + (sid === currentVal ? ' selected' : '') + '>' + sid + '</option>');
      });
    } else {
      html = '{{ text_none }}';
    }
    $('#gw-senderids').html(html);
  }

  // ---------------------------------------------------------------
  // 14. Helper: update coverage display
  // ---------------------------------------------------------------
  function updateCoverage(coverage) {
    var html = '';
    if (coverage && coverage.length > 0) {
      $.each(coverage, function(i, country) {
        html += '<span class="badge bg-info text-dark">' + country + '</span> ';
      });
    } else {
      html = '{{ text_none }}';
    }
    $('#gw-coverage').html(html);
  }

  // ---------------------------------------------------------------
  // Load logs on initial page load if logs tab is active
  // ---------------------------------------------------------------
  if (hash === '#tab-logs') {
    loadSmsLog(1);
    loadDebugLog(1);
  }

  // Also load logs when clicking log sub-tabs
  $('#log-subtabs a[data-bs-toggle="pill"]').on('shown.bs.tab', function(e) {
    if ($(e.target).attr('href') === '#subtab-sms-log') {
      loadSmsLog(1);
    } else if ($(e.target).attr('href') === '#subtab-debug-log') {
      loadDebugLog(1);
    }
  });
});
</script>
