{{ header }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="button" id="button-save" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{ button_save }}</button>
        <a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i> {{ button_cancel }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div id="kwtsms-alert" class=""></div>

    <ul class="nav nav-tabs" id="kwtsms-tabs">
      <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-dashboard"><i class="fa-solid fa-gauge-high"></i> {{ tab_dashboard }}</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-settings"><i class="fa-solid fa-gear"></i> {{ tab_settings }}</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-gateway"><i class="fa-solid fa-tower-cell"></i> {{ tab_gateway }}</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-templates"><i class="fa-solid fa-file-lines"></i> {{ tab_templates }}</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-logs"><i class="fa-solid fa-list-check"></i> {{ tab_logs }}</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-help"><i class="fa-solid fa-circle-question"></i> {{ tab_help }}</a>
      </li>
    </ul>

    <div class="tab-content" id="kwtsms-tab-content">

      {# ============================================================ #}
      {# TAB 1: DASHBOARD                                             #}
      {# ============================================================ #}
      <div class="tab-pane fade show active" id="tab-dashboard">
        <div class="row mt-3">
          {# Today #}
          <div class="col-lg-4 mb-3">
            <div class="card">
              <div class="card-header" style="background-color: #FFA200; color: #fff;">
                <i class="fa-solid fa-calendar-day"></i> {{ text_today }}
              </div>
              <div class="card-body">
                <span class="badge" style="background-color: #FFA200; color: #fff;" id="stat-today-sent">{{ text_sms_sent }}: {{ stats_today.sent }}</span>
                <span class="badge bg-danger" id="stat-today-failed">{{ text_sms_failed }}: {{ stats_today.failed }}</span>
                <span class="badge bg-secondary" id="stat-today-skipped">{{ text_sms_skipped }}: {{ stats_today.skipped }}</span>
              </div>
            </div>
          </div>
          {# 7 Days #}
          <div class="col-lg-4 mb-3">
            <div class="card">
              <div class="card-header" style="background-color: #FFA200; color: #fff;">
                <i class="fa-solid fa-calendar-week"></i> {{ text_7_days }}
              </div>
              <div class="card-body">
                <span class="badge" style="background-color: #FFA200; color: #fff;" id="stat-7days-sent">{{ text_sms_sent }}: {{ stats_7days.sent }}</span>
                <span class="badge bg-danger" id="stat-7days-failed">{{ text_sms_failed }}: {{ stats_7days.failed }}</span>
                <span class="badge bg-secondary" id="stat-7days-skipped">{{ text_sms_skipped }}: {{ stats_7days.skipped }}</span>
              </div>
            </div>
          </div>
          {# 30 Days #}
          <div class="col-lg-4 mb-3">
            <div class="card">
              <div class="card-header" style="background-color: #FFA200; color: #fff;">
                <i class="fa-solid fa-calendar"></i> {{ text_30_days }}
              </div>
              <div class="card-body">
                <span class="badge" style="background-color: #FFA200; color: #fff;" id="stat-30days-sent">{{ text_sms_sent }}: {{ stats_30days.sent }}</span>
                <span class="badge bg-danger" id="stat-30days-failed">{{ text_sms_failed }}: {{ stats_30days.failed }}</span>
                <span class="badge bg-secondary" id="stat-30days-skipped">{{ text_sms_skipped }}: {{ stats_30days.skipped }}</span>
              </div>
            </div>
          </div>
        </div>

        {# Status indicators #}
        <div class="row">
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_balance }}</small><br>
                <strong id="dash-balance">{% if gateway_balance is not null %}{{ gateway_balance }} {{ text_credits }}{% else %}--{% endif %}</strong>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_sender_id }}</small><br>
                <strong id="dash-sender-id">{{ module_kwtsms_sender_id ?: (gateway_configured ? 'KWT-SMS' : '--') }}</strong>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_test_mode }}</small><br>
                {% if module_kwtsms_test_mode %}
                <span class="badge bg-warning text-dark" id="dash-test-mode">{{ text_on }}</span>
                {% else %}
                <span class="badge bg-success" id="dash-test-mode">{{ text_off }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_gateway_status }}</small><br>
                {% if gateway_configured %}
                <span class="badge bg-success" id="dash-gateway">{{ text_connected }}</span>
                {% else %}
                <span class="badge bg-danger" id="dash-gateway">{{ text_disconnected }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_global_status }}</small><br>
                {% if module_kwtsms_status %}
                <span class="badge bg-success" id="dash-enabled">{{ text_yes }}</span>
                {% else %}
                <span class="badge bg-secondary" id="dash-enabled">{{ text_no }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="card text-center">
              <div class="card-body p-2">
                <small class="text-muted">{{ text_debug_status }}</small><br>
                {% if module_kwtsms_debug %}
                <span class="badge bg-warning text-dark" id="dash-debug">{{ text_on }}</span>
                {% else %}
                <span class="badge bg-success" id="dash-debug">{{ text_off }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>

      {# ============================================================ #}
      {# TAB 2: SETTINGS                                              #}
      {# ============================================================ #}
      <div class="tab-pane fade" id="tab-settings">
        <div class="card mt-3">
          <div class="card-header" style="background-color: #FFA200; color: #fff;">
            <i class="fa-solid fa-gear"></i> {{ tab_settings }}
          </div>
          <div class="card-body">
            <form id="form-settings">
              {# Enable Extension #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch">
                    <input type="hidden" name="module_kwtsms_status" value="0">
                    <input class="form-check-input" type="checkbox" name="module_kwtsms_status" value="1" id="input-status" {% if module_kwtsms_status %}checked{% endif %}>
                  </div>
                  <small class="form-text text-muted">{{ help_status }}</small>
                </div>
              </div>

              {# Test Mode #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_test_mode }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch">
                    <input type="hidden" name="module_kwtsms_test_mode" value="0">
                    <input class="form-check-input" type="checkbox" name="module_kwtsms_test_mode" value="1" id="input-test-mode" {% if module_kwtsms_test_mode %}checked{% endif %}>
                  </div>
                  <small class="form-text text-muted">{{ help_test_mode }}</small>
                </div>
              </div>

              {# Admin Phone Numbers #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-admin-phones">{{ entry_admin_phones }}</label>
                <div class="col-sm-9">
                  <input type="text" name="module_kwtsms_admin_phones" value="{{ module_kwtsms_admin_phones }}" id="input-admin-phones" class="form-control" placeholder="96598765432,96512345678">
                  <small class="form-text text-muted">{{ help_admin_phones }}</small>
                </div>
              </div>

              {# Customer Notification Statuses #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_customer_statuses }}</label>
                <div class="col-sm-9">
                  <small class="form-text text-muted mb-2 d-block">{{ help_customer_statuses }}</small>
                  {% for order_status in order_statuses %}
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="module_kwtsms_customer_statuses[]" value="{{ order_status.order_status_id }}" id="input-customer-status-{{ order_status.order_status_id }}" {% if order_status.order_status_id in module_kwtsms_customer_statuses %}checked{% endif %}>
                    <label class="form-check-label" for="input-customer-status-{{ order_status.order_status_id }}">{{ order_status.name }}</label>
                  </div>
                  {% endfor %}
                </div>
              </div>

              {# Admin Paid Order Statuses #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_admin_paid_statuses }}</label>
                <div class="col-sm-9">
                  <small class="form-text text-muted mb-2 d-block">{{ help_admin_paid_statuses }}</small>
                  {% for order_status in order_statuses %}
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="module_kwtsms_admin_paid_statuses[]" value="{{ order_status.order_status_id }}" id="input-admin-paid-status-{{ order_status.order_status_id }}" {% if order_status.order_status_id in module_kwtsms_admin_paid_statuses %}checked{% endif %}>
                    <label class="form-check-label" for="input-admin-paid-status-{{ order_status.order_status_id }}">{{ order_status.name }}</label>
                  </div>
                  {% endfor %}
                </div>
              </div>

              {# Admin Problem Statuses #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_admin_problem_statuses }}</label>
                <div class="col-sm-9">
                  <small class="form-text text-muted mb-2 d-block">{{ help_admin_problem_statuses }}</small>
                  {% for order_status in order_statuses %}
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="module_kwtsms_admin_problem_statuses[]" value="{{ order_status.order_status_id }}" id="input-admin-problem-status-{{ order_status.order_status_id }}" {% if order_status.order_status_id in module_kwtsms_admin_problem_statuses %}checked{% endif %}>
                    <label class="form-check-label" for="input-admin-problem-status-{{ order_status.order_status_id }}">{{ order_status.name }}</label>
                  </div>
                  {% endfor %}
                </div>
              </div>

              {# Low Stock Threshold #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">{{ entry_low_stock_threshold }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_kwtsms_low_stock_threshold" value="{{ module_kwtsms_low_stock_threshold }}" class="form-control" min="0" style="max-width: 120px;" />
                  <small class="text-muted">{{ help_low_stock_threshold }}</small>
                </div>
              </div>

              {# Customer Event Notifications #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">{{ entry_customer_events }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch mb-1">
                    <input type="checkbox" name="module_kwtsms_customer_events[]" value="customer_registered" class="form-check-input" id="event-customer-registered"
                      {% if module_kwtsms_customer_events is iterable and 'customer_registered' in module_kwtsms_customer_events %}checked{% endif %} />
                    <label class="form-check-label" for="event-customer-registered">{{ text_event_customer_registered }}</label>
                  </div>
                </div>
              </div>

              {# Admin Event Notifications #}
              <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">{{ entry_admin_events }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch mb-1">
                    <input type="checkbox" name="module_kwtsms_admin_events[]" value="admin_new_customer" class="form-check-input" id="event-admin-new-customer"
                      {% if module_kwtsms_admin_events is iterable and 'admin_new_customer' in module_kwtsms_admin_events %}checked{% endif %} />
                    <label class="form-check-label" for="event-admin-new-customer">{{ text_event_admin_new_customer }}</label>
                  </div>
                  <div class="form-check form-switch mb-1">
                    <input type="checkbox" name="module_kwtsms_admin_events[]" value="low_stock" class="form-check-input" id="event-low-stock"
                      {% if module_kwtsms_admin_events is iterable and 'low_stock' in module_kwtsms_admin_events %}checked{% endif %} />
                    <label class="form-check-label" for="event-low-stock">{{ text_event_low_stock }}</label>
                  </div>
                  <div class="form-check form-switch mb-1">
                    <input type="checkbox" name="module_kwtsms_admin_events[]" value="admin_new_review" class="form-check-input" id="event-admin-new-review"
                      {% if module_kwtsms_admin_events is iterable and 'admin_new_review' in module_kwtsms_admin_events %}checked{% endif %} />
                    <label class="form-check-label" for="event-admin-new-review">{{ text_event_admin_new_review }}</label>
                  </div>
                  <div class="form-check form-switch mb-1">
                    <input type="checkbox" name="module_kwtsms_admin_events[]" value="admin_return_request" class="form-check-input" id="event-admin-return-request"
                      {% if module_kwtsms_admin_events is iterable and 'admin_return_request' in module_kwtsms_admin_events %}checked{% endif %} />
                    <label class="form-check-label" for="event-admin-return-request">{{ text_event_admin_return_request }}</label>
                  </div>
                </div>
              </div>

              {# COD OTP Verification #}
              <hr class="my-4"/>
              <h5 style="color: #FFA200;"><i class="fa-solid fa-shield-halved"></i> {{ text_otp_settings }}</h5>
              <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_otp_sender_warning }}</div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">{{ entry_cod_otp_enabled }}</label>
                <div class="col-sm-9">
                  <div class="form-check form-switch">
                    <input type="checkbox" name="module_kwtsms_cod_otp_enabled" value="1" class="form-check-input" id="input-cod-otp-enabled"
                      {% if module_kwtsms_cod_otp_enabled %}checked{% endif %} />
                    <label class="form-check-label" for="input-cod-otp-enabled">{{ help_cod_otp_enabled }}</label>
                  </div>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_otp_length }}</label>
                <div class="col-sm-9">
                  <select name="module_kwtsms_otp_length" class="form-select" style="max-width: 120px;">
                    {% for len in [4, 5, 6, 7, 8] %}
                      <option value="{{ len }}" {% if module_kwtsms_otp_length == len %}selected{% endif %}>{{ len }} digits</option>
                    {% endfor %}
                  </select>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_otp_expiry }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_kwtsms_otp_expiry" value="{{ module_kwtsms_otp_expiry }}" class="form-control" min="1" max="30" style="max-width: 120px;" />
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_otp_max_per_phone }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_kwtsms_otp_max_per_phone" value="{{ module_kwtsms_otp_max_per_phone }}" class="form-control" min="1" max="50" style="max-width: 120px;" />
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_otp_max_per_ip }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_kwtsms_otp_max_per_ip" value="{{ module_kwtsms_otp_max_per_ip }}" class="form-control" min="1" max="100" style="max-width: 120px;" />
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">{{ entry_otp_resend_cooldown }}</label>
                <div class="col-sm-9">
                  <input type="number" name="module_kwtsms_otp_resend_cooldown" value="{{ module_kwtsms_otp_resend_cooldown }}" class="form-control" min="30" max="300" style="max-width: 120px;" />
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      {# ============================================================ #}
      {# TAB 3: GATEWAY                                               #}
      {# ============================================================ #}
      <div class="tab-pane fade" id="tab-gateway">
        <div class="row mt-3">
          <div class="col-lg-6 mb-3">
            {# Logged-out: Login form #}
            <div class="card" id="gateway-login" {% if gateway_configured %}style="display:none;"{% endif %}>
              <div class="card-header" style="background-color: #FFA200; color: #fff;">
                <i class="fa-solid fa-right-to-bracket"></i> {{ text_login }}
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <label for="input-gw-username" class="form-label">{{ entry_username }}</label>
                  <input type="text" class="form-control" id="input-gw-username" autocomplete="off">
                </div>
                <div class="mb-3">
                  <label for="input-gw-password" class="form-label">{{ entry_password }}</label>
                  <input type="password" class="form-control" id="input-gw-password" autocomplete="off">
                </div>
                <button type="button" id="button-gateway-login" class="btn" style="background-color: #FFA200; color: #fff;">
                  <i class="fa-solid fa-right-to-bracket"></i> {{ text_login }}
                </button>
              </div>
            </div>

            {# Logged-in: Connection info #}
            <div class="card" id="gateway-connected" {% if not gateway_configured %}style="display:none;"{% endif %}>
              <div class="card-header bg-success text-white">
                <i class="fa-solid fa-link"></i> {{ text_connected }}
              </div>
              <div class="card-body">
                <div class="mb-2">
                  <strong>{{ text_balance }}:</strong>
                  <span id="gw-balance">{% if gateway_balance is not null %}{{ gateway_balance }} {{ text_credits }}{% else %}--{% endif %}</span>
                </div>
                <div class="mb-2">
                  <strong>{{ text_senderids }}:</strong>
                  <span id="gw-senderids">
                    {% if gateway_senderids %}
                      {% for sid in gateway_senderids %}
                      <span class="badge bg-secondary">{{ sid }}</span>
                      {% endfor %}
                    {% else %}
                      {{ text_none }}
                    {% endif %}
                  </span>
                </div>
                <div class="mb-3">
                  <strong>{{ text_coverage }}:</strong>
                  <span id="gw-coverage">
                    {% if gateway_coverage %}
                      {% for country in gateway_coverage %}
                      <span class="badge bg-info text-dark">{{ country }}</span>
                      {% endfor %}
                    {% else %}
                      {{ text_none }}
                    {% endif %}
                  </span>
                </div>
                <button type="button" id="button-gateway-reload" class="btn btn-outline-primary me-2">
                  <i class="fa-solid fa-rotate"></i> {{ text_reload }}
                </button>
                <button type="button" id="button-gateway-logout" class="btn btn-outline-danger">
                  <i class="fa-solid fa-right-from-bracket"></i> {{ text_logout }}
                </button>
              </div>
            </div>
          </div>

          <div class="col-lg-6 mb-3">
            {# Gateway Settings #}
            <div class="card mb-3">
              <div class="card-header" style="background-color: #FFA200; color: #fff;">
                <i class="fa-solid fa-sliders"></i> {{ tab_gateway }} {{ tab_settings }}
              </div>
              <div class="card-body">
                <form id="form-gateway-settings">
                  <div class="mb-3">
                    <label for="input-sender-id" class="form-label">{{ entry_sender_id }}</label>
                    <select class="form-select" id="input-sender-id" name="module_kwtsms_sender_id">
                      {% if gateway_senderids %}
                        {% for sid in gateway_senderids %}
                          <option value="{{ sid }}"{% if sid == module_kwtsms_sender_id %} selected{% endif %}>{{ sid }}</option>
                        {% endfor %}
                      {% else %}
                        <option value="KWT-SMS"{% if module_kwtsms_sender_id == 'KWT-SMS' or not module_kwtsms_sender_id %} selected{% endif %}>KWT-SMS</option>
                      {% endif %}
                    </select>
                  </div>
                  <div class="mb-3">
                    <label for="input-country-code" class="form-label">{{ entry_country_code }}</label>
                    <input type="text" name="country_code" value="{{ module_kwtsms_country_code }}" id="input-country-code" class="form-control" placeholder="965">
                    <small class="form-text text-muted">{{ help_country_code }}</small>
                  </div>
                  <div class="mb-3">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" name="debug" value="1" id="input-gw-debug" {% if module_kwtsms_debug %}checked{% endif %}>
                      <label class="form-check-label" for="input-gw-debug">{{ entry_debug }}</label>
                    </div>
                    <small class="form-text text-muted">{{ help_debug }}</small>
                  </div>
                  <button type="button" id="button-gateway-save" class="btn" style="background-color: #FFA200; color: #fff;">
                    <i class="fa-solid fa-floppy-disk"></i> {{ button_save }}
                  </button>
                </form>
              </div>
            </div>

            {# Test Gateway #}
            <div class="card">
              <div class="card-header" style="background-color: #79CCF2; color: #fff;">
                <i class="fa-solid fa-vial"></i> {{ text_test_gateway }}
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <label for="input-test-phone" class="form-label">{{ entry_test_phone }}</label>
                  <input type="text" class="form-control" id="input-test-phone" placeholder="96598765432">
                </div>
                <div class="mb-3">
                  <label for="input-test-message" class="form-label">{{ entry_test_message }}</label>
                  <textarea class="form-control" id="input-test-message" rows="3">kwtSMS Gateway Test</textarea>
                </div>
                <button type="button" id="button-test-gateway" class="btn" style="background-color: #79CCF2; color: #fff;">
