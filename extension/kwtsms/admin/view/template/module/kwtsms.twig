              <li class="mb-2"><a href="https://www.kwtsms.com/faq_all.php" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-circle-question"></i> {{ text_help_link_faq }}</a></li>
              <li class="mb-2"><a href="https://www.kwtsms.com/doc/KwtSMS.com_API_Documentation_v41.pdf" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-pdf"></i> {{ text_help_link_docs }}</a></li>
              <li><a href="https://www.kwtsms.com/sender-id-help.html" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-id-badge"></i> {{ text_help_link_senderid }}</a></li>
